# Copy to .env in this repo's root (git-ignored) and fill in.
# pr-review loads it automatically; variables already set in your shell win.

# --adapter github (github.com). GH_TOKEN is accepted as an alias.
# Classic token: `repo` scope; fine-grained: Pull requests read/write + Contents read.
GITHUB_TOKEN=

# --adapter azure. PAT scope: Code (Read & Write).
AZURE_DEVOPS_PAT=

# Optional. Defaults shown.
PR_REVIEW_MODEL=anthropic/claude-sonnet-5-5
# off | minimal | low | medium | high | xhigh | max
PR_REVIEW_THINKING=medium
